{
    "name": "@neoj/cli",
    "version": "0.0.9",
    "description": "A CLI for competitive programming workflows",
    "license": "MIT",
    "author": {
        "name": "e6nlaq"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/e6nlaq/neoj.git"
    },
    "bin": {
        "neoj": "./bin/neoj.js"
    },
    "workspaces": [
        "packages/*"
    ],
    "files": [
        "bin",
        "README.md",
        "LICENSE",
        "THIRD_PARTY_NOTICES.txt"
    ],
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "typecheck": "bun check",
        "test": "bun run template-assets && bun test",
        "build": "bun run template-assets && bun run --filter @neoj/api build && rm -rf dist && bun build ./src/index.ts --target bun --outdir dist --packages external --check --minify",
        "neoj": "cd tmp && bun run ../src/index.ts",
        "schema": "bun run scripts/generate-schema.ts",
        "set-version": "bun run scripts/set-version.ts",
        "template-assets": "bun run scripts/generate-template-assets.ts",
        "notices": "bun run scripts/generate-notices.ts",
        "format": "bun fmt",
        "format:check": "bun fmt --check",
        "lint": "oxlint",
        "hooks": "lefthook install"
    },
    "devDependencies": {
        "@commander-js/extra-typings": "^15.1.0",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@inquirer/prompts": "^8.8.0",
        "@neoj/api": "0.0.9",
        "@types/bun": "^1.4.4",
        "@types/semver": "^7.8.0",
        "@valibot/to-json-schema": "^1.8.0",
        "consola": "^3.4.2",
        "env-paths": "^4.0.0",
        "lefthook": "^2.2.2",
        "node-html-parser": "^9.0.7",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "semver": "^7.8.6",
        "tiny-open": "^1.3.0",
        "tinyclip": "^1.0.3",
        "valibot": "^1.5.0"
    },
    "optionalDependencies": {
        "@neoj/cli-darwin-arm64": "0.0.9",
        "@neoj/cli-darwin-x64": "0.0.9",
        "@neoj/cli-linux-arm64": "0.0.9",
        "@neoj/cli-linux-x64": "0.0.9",
        "@neoj/cli-win32-x64": "0.0.9"
    },
    "engines": {
        "node": ">=18"
    }
}
