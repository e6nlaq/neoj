{
    "name": "neoj",
    "version": "0.0.1",
    "private": true,
    "description": "A CLI for competitive programming workflows, starting with AtCoder.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/e6nlaq/neoj.git"
    },
    "bin": {
        "neoj": "./dist/index.js"
    },
    "type": "module",
    "scripts": {
        "typecheck": "bun check",
        "test": "bun test",
        "build": "rm -rf dist && bun build ./src/index.ts --target bun --outdir dist --packages external --splitting --check --minify && bun run scripts/copy-template-assets.ts",
        "neoj": "bun run src/index.ts",
        "format": "bun fmt",
        "lint": "oxlint",
        "prepare": "lefthook install"
    },
    "dependencies": {
        "@commander-js/extra-typings": "^15.0.0",
        "@inquirer/prompts": "^8.7.5",
        "consola": "^3.4.2",
        "env-paths": "^4.0.0",
        "node-html-parser": "^9.0.5",
        "valibot": "^1.5.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@types/bun": "latest",
        "lefthook": "^2.2.2",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0"
    },
    "engines": {
        "bun": ">=1.4.0"
    }
}
