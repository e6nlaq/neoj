{
    "name": "neoj",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "module": "index.ts",
    "scripts": {
        "typecheck": "bun check",
        "build": "rm -rf dist && bun build ./src/index.ts --target bun --outdir dist --packages external --splitting --check --minify",
        "neoj": "bun run src/index.ts"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0"
    },
    "bin": {
        "neoj": "./dist/index.js"
    },
    "peerDependencies": {
        "commander": "^15.0.0",
        "typescript": "^7"
    },
    "dependencies": {
        "@commander-js/extra-typings": "^15.0.0",
        "@elysiajs/cors": "^1.4.2",
        "consola": "^3.4.2",
        "elysia": "^1.4.30",
        "tinyclip": "^1.0.3"
    }
}
