{
    "name": "neoj",
    "version": "0.0.1",
    "private": true,
    "bin": {
        "neoj": "./dist/index.js"
    },
    "type": "module",
    "module": "index.ts",
    "scripts": {
        "typecheck": "bun check",
        "build": "rm -rf dist && bun build ./src/index.ts --target bun --outdir dist --packages external --splitting --check --minify && bun run scripts/copy-template-assets.ts",
        "neoj": "bun run src/index.ts",
        "format": "bun fmt",
        "lint": "oxlint",
        "prepare": "lefthook install"
    },
    "dependencies": {
        "@commander-js/extra-typings": "^15.0.0",
        "@elysiajs/cors": "^1.4.2",
        "@inquirer/prompts": "^8.7.5",
        "consola": "^3.4.2",
        "elysia": "^1.4.30",
        "env-paths": "^4.0.0",
        "node-html-parser": "^9.0.5",
        "tinyclip": "^1.0.3",
        "valibot": "^1.5.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@types/bun": "latest",
        "lefthook": "^2.2.2",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0"
    },
    "peerDependencies": {
        "commander": "^15.0.0",
        "typescript": "^7"
    }
}
