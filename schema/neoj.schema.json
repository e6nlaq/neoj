{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/e6nlaq/neoj/main/schema/neoj.schema.json",
    "title": "neoj configuration",
    "type": "object",
    "properties": {
        "src": {
            "type": "string",
            "minLength": 1,
            "description": "Destination directory for the solution template, relative to the project root. Required when template.enable is true."
        },
        "alias": {
            "type": "object",
            "propertyNames": {
                "type": "string",
                "description": "Alias name. Must not be \".\", \"..\", or contain a path separator.",
                "pattern": "^(?!\\.{1,2}$)[^/\\\\]+$",
                "minLength": 1
            },
            "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "description": "Path of the source file this alias expands to, relative to the project root."
            },
            "description": "Extra names for source files, accepted by neoj test in place of a path.",
            "default": {}
        },
        "login": {
            "type": "object",
            "properties": {
                "open_browser": {
                    "type": "boolean",
                    "description": "Open the browser automatically during the yukicoder device flow.",
                    "default": true
                },
                "auto_login": {
                    "type": "boolean",
                    "description": "Start the login flow automatically when neoj submit needs an account.",
                    "default": true
                }
            },
            "required": [],
            "additionalProperties": false,
            "description": "How neoj behaves during login.",
            "default": {
                "open_browser": true,
                "auto_login": true
            }
        },
        "testcase": {
            "type": "object",
            "properties": {
                "folder": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Directory that receives downloaded samples and handmade test cases, relative to the project root.",
                    "default": "test"
                },
                "filename": {
                    "type": "string",
                    "description": "Base name for each sample file. Must contain exactly one {} that is replaced by the sample number.",
                    "pattern": "^[^<>:\"/\\\\|?*{}]*\\{\\}[^<>:\"/\\\\|?*{}]*$",
                    "default": "sample-{}"
                }
            },
            "required": [],
            "additionalProperties": false,
            "description": "Where and how sample tests are written.",
            "default": {
                "folder": "test",
                "filename": "sample-{}"
            }
        },
        "handmade": {
            "type": "object",
            "properties": {
                "filename": {
                    "type": "string",
                    "description": "Base name for each handmade test case. Must contain exactly one {} that is replaced by the case number.",
                    "pattern": "^[^<>:\"/\\\\|?*{}]*\\{\\}[^<>:\"/\\\\|?*{}]*$",
                    "default": "handmade-{}"
                }
            },
            "required": [],
            "additionalProperties": false,
            "description": "How neoj writes test cases created by hand.",
            "default": {
                "filename": "handmade-{}"
            }
        },
        "test": {
            "type": "object",
            "properties": {
                "source": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Source file that neoj test builds by default, relative to the project root."
                },
                "interactor": {
                    "type": "object",
                    "properties": {
                        "source": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Interactor file that judges an interactive solution, relative to the project root."
                        },
                        "compile": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1
                            },
                            "description": "Command and arguments that build the interactor into {outfile} or {outdir}. Defaults to the matching [languages.<key>].compile."
                        },
                        "run": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1
                            },
                            "description": "Command and arguments that run the interactor. Defaults to the matching [languages.<key>].run. Add {infile} to receive the test case path."
                        },
                        "timeout": {
                            "type": "number",
                            "minimum": 0.001,
                            "description": "Wall-clock limit for the whole interactive session in seconds.",
                            "default": 15
                        }
                    },
                    "required": ["source"],
                    "additionalProperties": false,
                    "description": "Interactor used by neoj test --interactive. It reads the solution's output on standard input and writes the next prompt to standard output."
                },
                "judge": {
                    "type": "object",
                    "properties": {
                        "source": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Checker file that judges a multi-answer solution, relative to the project root."
                        },
                        "compile": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1
                            },
                            "description": "Command and arguments that build the checker into {outfile} or {outdir}. Defaults to the matching [languages.<key>].compile."
                        },
                        "run": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1
                            },
                            "description": "Command and arguments that run the checker. Defaults to the matching [languages.<key>].run. Add {infile} to receive the test case path."
                        },
                        "timeout": {
                            "type": "number",
                            "minimum": 0.001,
                            "description": "Wall-clock limit for the checker in seconds.",
                            "default": 10
                        }
                    },
                    "required": ["source"],
                    "additionalProperties": false,
                    "description": "Checker used by neoj test --judge. It reads the solution's output on standard input and exits 0 to accept it."
                },
                "timeout": {
                    "type": "number",
                    "minimum": 0.001,
                    "description": "Default time limit per test case in seconds.",
                    "default": 10
                },
                "memory": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Default memory limit per test case in MiB.",
                    "default": 1024
                },
                "parallel": {
                    "type": "boolean",
                    "description": "Run test cases in parallel.",
                    "default": true
                },
                "cache": {
                    "type": "boolean",
                    "description": "Keep compiled binaries in .neoj/build and skip compiling unchanged sources.",
                    "default": false
                },
                "error": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 15,
                    "description": "Exponent of the floating-point tolerance used by neoj test --error: 10^-error. The option turns the tolerance on; this value is used when it has no argument.",
                    "default": 6
                },
                "ignore_trailing_space": {
                    "type": "boolean",
                    "description": "Ignore whitespace at the end of each output line when comparing.",
                    "default": false
                },
                "ignore_trailing_newline": {
                    "type": "boolean",
                    "description": "Ignore missing or extra newlines at the end of the output when comparing.",
                    "default": false
                },
                "show_stderr": {
                    "enum": ["always", "failure", "never"],
                    "type": "string",
                    "description": "Print the program's standard error in the report: \"always\", \"failure\" (only when a case did not pass), or \"never\".",
                    "default": "always"
                },
                "display_lines": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Lines shown per block in the report before the rest is summarised, such as the input or the program's output.",
                    "default": 30
                },
                "show_line_numbers": {
                    "type": "boolean",
                    "description": "Prefix each line of the report's input and output tables with its line number.",
                    "default": true
                }
            },
            "required": [],
            "additionalProperties": false,
            "description": "How neoj builds and runs test cases.",
            "default": {
                "timeout": 10,
                "memory": 1024,
                "parallel": true,
                "cache": false,
                "ignore_trailing_space": false,
                "ignore_trailing_newline": false,
                "show_stderr": "always",
                "display_lines": 30,
                "show_line_numbers": true
            }
        },
        "run": {
            "type": "object",
            "properties": {
                "silent": {
                    "type": "boolean",
                    "description": "Hide informational logs, such as the compile result, when neoj run executes a solution.",
                    "default": false
                }
            },
            "required": [],
            "additionalProperties": false,
            "description": "How neoj builds and runs a solution directly.",
            "default": {
                "silent": false
            }
        },
        "submit": {
            "type": "object",
            "properties": {
                "confirm": {
                    "type": "boolean",
                    "description": "Ask for confirmation before submitting. --yes skips the prompt.",
                    "default": true
                },
                "wait": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Seconds to wait before submitting, so a last check is still possible. --wait and --no-wait override it.",
                    "default": 3
                },
                "open": {
                    "type": "boolean",
                    "description": "Open the submission page in the browser after a successful submit.",
                    "default": true
                },
                "clip": {
                    "enum": ["never", "always", "fail"],
                    "type": "string",
                    "evenBetterToml": {
                        "docs": {
                            "enumValues": [
                                "Never copy the submitted source to the clipboard.",
                                "Copy the source to the clipboard after the presubmit command, then submit it.",
                                "Copy the source to the clipboard only when submitting fails."
                            ]
                        }
                    },
                    "description": "When neoj submit copies the source to the clipboard.",
                    "default": "never"
                },
                "preview_lines": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Number of lines shown at the start and end of the submission preview.",
                    "default": 5
                },
                "presubmit_timeout": {
                    "type": "number",
                    "minimum": 0.001,
                    "description": "Wall-clock limit for the presubmit command in seconds.",
                    "default": 30
                }
            },
            "required": [],
            "additionalProperties": false,
            "description": "How neoj submits a solution.",
            "default": {
                "confirm": true,
                "wait": 3,
                "open": true,
                "clip": "never",
                "preview_lines": 5,
                "presubmit_timeout": 30
            }
        },
        "languages": {
            "type": "object",
            "propertyNames": {
                "type": "string",
                "minLength": 1
            },
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "source": {
                        "anyOf": [
                            {
                                "type": "string",
                                "minLength": 1
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "minItems": 1
                            }
                        ],
                        "description": "Glob (or globs) that select the files written in this language, relative to the project root."
                    },
                    "compile": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        },
                        "description": "Command and arguments that build {source} into {outfile} or {outdir}. Omit it for interpreted languages."
                    },
                    "run": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        },
                        "minItems": 1,
                        "description": "Command and arguments that run the program."
                    },
                    "timeout": {
                        "type": "number",
                        "minimum": 0.001,
                        "description": "Time limit for this language in seconds."
                    },
                    "memory": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Memory limit for this language in MiB."
                    },
                    "cache_files": {
                        "anyOf": [
                            {
                                "type": "string",
                                "minLength": 1
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "minItems": 1
                            }
                        ],
                        "description": "Extra files whose contents belong in the compile cache key, such as shared headers."
                    },
                    "presubmit": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        },
                        "description": "Command and arguments that turn {source} into the text submitted for this language. Write the result to {outfile}, or let it print to standard output. Omit it to submit the source file as-is."
                    },
                    "submit": {
                        "type": "object",
                        "propertyNames": {
                            "type": "string",
                            "minLength": 1
                        },
                        "additionalProperties": {
                            "type": "string",
                            "minLength": 1
                        },
                        "description": "Platform language ID used by neoj submit, keyed by platform name such as atcoder or yukicoder."
                    }
                },
                "required": ["source", "run"],
                "additionalProperties": false,
                "description": "How to build and run one language."
            },
            "description": "Build and run commands per language, keyed by a name you choose such as cpp.",
            "default": {}
        },
        "download": {
            "type": "object",
            "properties": {
                "show_sample": {
                    "type": "boolean",
                    "description": "Print every downloaded sample's input and output after writing the files.",
                    "default": false
                }
            },
            "required": [],
            "additionalProperties": false,
            "description": "How neoj reports downloaded samples.",
            "default": {
                "show_sample": false
            }
        },
        "stash": {
            "type": "object",
            "properties": {
                "auto_stash": {
                    "type": "boolean",
                    "description": "Save the current problem's work before download replaces it.",
                    "default": false
                },
                "auto_apply": {
                    "type": "boolean",
                    "description": "Restore the downloaded problem's stash when one exists.",
                    "default": false
                },
                "force": {
                    "type": "boolean",
                    "description": "Allow neoj stash save to replace an existing stash without --force.",
                    "default": true
                }
            },
            "required": [],
            "additionalProperties": false,
            "description": "How neoj keeps per-problem work in sync with downloads.",
            "default": {
                "auto_stash": false,
                "auto_apply": false,
                "force": true
            }
        },
        "template": {
            "type": "object",
            "properties": {
                "enable": {
                    "type": "boolean",
                    "description": "Apply the template to src after each successful download. Requires src and template.folder.",
                    "default": false
                },
                "folder": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Directory holding the template files, relative to the project root."
                },
                "mode": {
                    "enum": ["overlay", "replace"],
                    "type": "string",
                    "evenBetterToml": {
                        "docs": {
                            "enumValues": [
                                "Copy the template over src, replacing files that exist in both places.",
                                "Remove the contents of src before copying the template."
                            ]
                        }
                    },
                    "description": "How the template is applied to src.",
                    "default": "overlay"
                }
            },
            "required": [],
            "additionalProperties": false,
            "description": "Template files applied to src after a download.",
            "default": {
                "enable": false,
                "mode": "overlay"
            }
        }
    },
    "required": [],
    "additionalProperties": false,
    "description": "neoj configuration, read from ~/.neoj.toml and the nearest project neoj.toml.",
    "allOf": [
        {
            "if": {
                "properties": {
                    "template": {
                        "properties": {
                            "enable": {
                                "const": true
                            }
                        },
                        "required": ["enable"]
                    }
                },
                "required": ["template"]
            },
            "then": {
                "properties": {
                    "template": {
                        "required": ["folder"]
                    }
                },
                "required": ["src"]
            }
        }
    ]
}
